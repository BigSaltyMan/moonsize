// Moonsize — a WebAssembly binary size analyzer for MoonBit.
name = "BigSaltyMan/moonsize"

version = "0.1.0"

import {
  "moonbitlang/x@0.5.5",
  "bikallem/compress@0.3.4",
}

readme = "README.md"

repository = "https://github.com/BigSaltyMan/moonsize"

license = "MIT"

keywords = [ "wasm", "webassembly", "size", "profiling", "cli" ]

description = "A Wasm size profiler for MoonBit — section breakdown, function ranking, call graph and retained-size analysis"

preferred_target = "native"
