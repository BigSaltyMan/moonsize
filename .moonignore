# What `moon publish` leaves out of the package.
#
# A `.moonignore` overrides the `.gitignore` in the same directory rather than
# adding to it, so the build directories are repeated here.
_build/
.mooncakes/
target/
node_modules/

# The rendered example report and screenshots belong in the repository, where
# the README links to them, not in a module somebody just `moon add`ed. The example's
# source and binary stay, along with the vendored chart source/license and the
# generated MoonBit resource compiled into the native CLI.
examples/report.html
examples/report.png
examples/report-desktop.jpg
examples/report-mobile.jpg
examples/report-update.*/

# Repository-only review evidence and local plans; never needed by consumers.
docs/review-artifacts/
docs/*-plan.md
docs/october-*.md
AGENTS.md

# Local ecosystem-scan output, never published.
.ecoscan/

# The library-consumer probe: part of the module so `moon check` covers it, but
# a program to run is not something to hand to whoever adds this package.
_probe/
