  ]
  // The one published way to build options.
  let options = @moonsize.Options::default("probe.wasm")
  match @moonsize.parse_module(bytes) {
    Ok(parsed) =>
      match @moonsize.analyze(bytes, parsed) {
        Ok(analysis) => {
          // Read every field a library caller is meant to consume.
          println(options.path)
          println(options.top)
          println(analysis.data.length())
          println(analysis.stats.length())
          println(analysis.retained.length())
          println(analysis.roots.length())
          println(analysis.reachable.length())
          println(analysis.indirect.length())
          println(
            @moonsize.render_top_functions(
              analysis.stats,
              analysis.data.length(),
              options.top,
            ),
          )
          println(@moonsize.render_html(analysis, options.path))
        }
        Err(error) => println(@moonsize.describe_error(error))
      }
    Err(error) => println(@moonsize.describe_error(error))
  }
}
